# --- Required ---------------------------------------------------------------
# Bot token from https://discord.com/developers/applications -> Bot -> Reset Token
DISCORD_TOKEN=your-bot-token-here
# Application ID from the same page, under General Information
DISCORD_CLIENT_ID=your-application-id-here

# Free API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-key-here

# Application PUBLIC KEY, from the same General Information page.
# Required ONLY for the Vercel / HTTP-interactions deployment, which uses it to
# verify that incoming requests genuinely came from Discord. The always-on
# gateway bot ignores it.
DISCORD_PUBLIC_KEY=your-application-public-key

# --- Optional ---------------------------------------------------------------
# Register commands to a single server for instant updates while developing.
# Leave empty to register globally (can take up to an hour to appear).
DISCORD_GUILD_ID=

# Model to use. Google retires models over time, and a retired one returns 404
# to newer API keys. Run `npm run models` to list what YOUR key can use, then
# put one of those names here.
GEMINI_MODEL=gemini-2.5-flash

# Google Search grounding on /ask. It has its own free-tier quota separate from
# the model's, so set this to false if grounding is what keeps hitting the cap.
# Time-sensitive questions get much weaker answers with it off.
ENABLE_SEARCH_GROUNDING=true

# Language the model writes its answers in. Name it in English (the system
# prompts are English and interpolate this), e.g. Vietnamese, English, Japanese.
# Note this only changes the model's output — the bot's own button/error text is
# hardcoded Vietnamese in src/.
RESPONSE_LANGUAGE=Vietnamese

# How many messages /tldr summarises when the option is omitted (1-200).
DEFAULT_TLDR_MESSAGES=100

# Per-request timeout against the Gemini API, in milliseconds.
GEMINI_TIMEOUT_MS=120000

# --- /epub ------------------------------------------------------------------
# These affect only /epub, which uses no API key at all.

# Most chapters to download from a single story.
EPUB_MAX_CHAPTERS=400

# Parallel chapter fetches. Higher finishes sooner but leans harder on the
# source site; 4 with a 250ms pause is a polite visitor.
EPUB_CONCURRENCY=4

# Wall clock allowed for one book, in milliseconds. Discord invalidates the
# interaction token 15 minutes after the command was used, so anything above
# ~14 minutes has nothing left to reply to and is capped in code.
EPUB_TIME_BUDGET_MS=780000

# Attachment size ceiling in MB. Discord's real limit depends on the server's
# boost tier: 10 MB unboosted, 50 at tier 2, 100 at tier 3. Raise this only if
# your server actually allows bigger uploads.
EPUB_MAX_UPLOAD_MB=9
